NODE_ENV=development
PORT=5000
DATABASE_URL=mysql://asaankhata:replace_me@127.0.0.1:3306/asaankhata
JWT_SECRET=replace_me_with_random_32_plus_characters
REFRESH_SECRET=replace_me_with_another_random_32_plus_characters
BUCKET_PATH=/srv/asaankhata/uploads
BUCKET_BASE_URL=https://api.example.com/uploads

# Browser admin panel origins only; native app requests have no Origin header.
CORS_ALLOWED_ORIGINS=
# Set to 1 only when one trusted reverse proxy sits directly in front of Node.
TRUST_PROXY_HOPS=0
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

APP_NAME=AsaanKhata
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Provision a real, ordinary shop-owner account for Play review, then enter
# these credentials into Play Console's app access instructions. Never bundle
# the password into the Expo app or bypass login for reviewers.
PLAY_REVIEWER_EMAIL=
PLAY_REVIEWER_PASSWORD=

# Existing optional integrations: configure only if used.
REVENUECAT_WEBHOOK_SECRET=
REVENUECAT_API_KEY=
REVENUECAT_LIFETIME_SINGLE_SHOP_PRODUCT_ID=lifetime_offline_single_shop
REVENUECAT_LIFETIME_MULTI_SHOP_PRODUCT_ID=lifetime_offline_multi_shop
REVENUECAT_BASIC_MONTHLY_PRODUCT_ID=asaandukaan_basic:monthly
REVENUECAT_BASIC_SEMIANNUAL_PRODUCT_ID=asaandukaan_basic:six-month
REVENUECAT_BASIC_YEARLY_PRODUCT_ID=asaandukaan_basic:yearly
REVENUECAT_PRO_MONTHLY_PRODUCT_ID=asaandukaan_pro:monthly
REVENUECAT_PRO_SEMIANNUAL_PRODUCT_ID=asaandukaan_pro:six-month
REVENUECAT_PRO_YEARLY_PRODUCT_ID=asaandukaan_pro:yearly
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
