# ----------------------------------------------------------------------------
# Server
# ----------------------------------------------------------------------------

# Port the Express server listens on.
PORT=5000

# ----------------------------------------------------------------------------
# Database
# ----------------------------------------------------------------------------

# MySQL connection string Prisma uses for every query (see prisma/schema.prisma).
DATABASE_URL="mysql://user:password@localhost:3306/assankhata"

# ----------------------------------------------------------------------------
# Auth
# ----------------------------------------------------------------------------

# Signs/verifies both Admin and SuperAdmin access tokens (see middleware/authMiddleware.js).
JWT_SECRET=change-me-to-a-long-random-string

# Signs/verifies both Admin and SuperAdmin refresh tokens.
REFRESH_SECRET=change-me-to-a-different-long-random-string

# ----------------------------------------------------------------------------
# Image uploads (utils/bucketStorage.js)
# ----------------------------------------------------------------------------

# Local filesystem folder product/category images are written to.
BUCKET_PATH=./uploads

# Public base URL those uploaded files are served from (prefixed onto stored filenames).
BUCKET_BASE_URL=http://localhost:5000/uploads

# ----------------------------------------------------------------------------
# Subscriptions / RevenueCat
# ----------------------------------------------------------------------------

# Length of the free trial (days) newly registered admins get (prisma/seed.js).
FREE_TRIAL_DAYS=15

# Shared secret RevenueCat sends in the Authorization header of its webhook calls.
REVENUECAT_WEBHOOK_SECRET=

# RevenueCat REST API key, used to reconcile a subscriber on-demand (services/revenueCatService.js).
REVENUECAT_API_KEY=

# ----------------------------------------------------------------------------
# Cron
# ----------------------------------------------------------------------------

# Set to "true" to run the hourly subscription-expiry sweep on boot (cron/index.js).
ENABLE_CRON=false

# ----------------------------------------------------------------------------
# Ads + reward-coins economy
# ----------------------------------------------------------------------------

# Coins credited to Admin.adCoins per completed reward-ad view.
REWARD_AD_COIN_VALUE=1

# Max reward ads (and coin grants) counted per admin per UTC calendar day.
MAX_REWARD_ADS_PER_DAY=15

# Coins spent to open a free-tier admin's short cloud-sync push unlock window.
SYNC_COIN_COST=5

# Records (e.g. bills) a free-tier admin can create per day before coin spend is needed.
FREE_DAILY_RECORD_LIMIT=15

# Coins deducted per offline-created bill when a free-tier device reconciles its
# coin-usage ledger (POST /ads/coin-usage/sync). Server-defined and authoritative —
# never trusts a client-supplied amount, to prevent a tampered client from
# reconciling an arbitrary coin delta.
BILL_COIN_COST=1

# ----------------------------------------------------------------------------
# Firebase Cloud Messaging (push notifications)
# ----------------------------------------------------------------------------

# Firebase service account credentials as a raw JSON string (checked first).
# Leave unset in most environments — prefer FIREBASE_SERVICE_ACCOUNT_PATH locally.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Path to a Firebase service account JSON file (checked if the JSON var above isn't set).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# Firebase project ID (optional — usually already embedded in the service account JSON).
FIREBASE_PROJECT_ID=
